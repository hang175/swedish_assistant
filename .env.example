# Copy this file to ".env.local" and fill in the two values from
# Supabase dashboard -> Project Settings -> API.  Both are public values, safe to ship in the web page.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional – only for generating lesson audio (npm run build:audio).
# Azure portal -> your Speech resource -> Keys and Endpoint.
AZURE_SPEECH_KEY=YOUR-KEY
AZURE_SPEECH_REGION=swedencentral
